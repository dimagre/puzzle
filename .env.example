# Database
DATABASE_URL="postgresql://user:password@localhost:5432/puzzleshare?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Self-pickup addresses shown on the checkout page
NEXT_PUBLIC_PICKUP_WAREHOUSE_ADDRESS="м. Київ, вул. Промислова 1 (склад)"
NEXT_PUBLIC_PICKUP_SELLER_ADDRESS="м. Київ, вул. Хрещатик 22 (за домовленістю)"

# Monobank Acquiring (https://api.monobank.ua/docs/acquiring.html)
MONOBANK_TOKEN="your-merchant-x-token"

# Email (Resend — https://resend.com)
# Leave RESEND_API_KEY empty in local dev to skip email sending without errors.
RESEND_API_KEY=""
ADMIN_EMAIL="admin@puzzleshare.ua"
EMAIL_FROM="PuzzleShare <noreply@ukraone.com.ua>"
